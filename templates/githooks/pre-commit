#!/bin/sh
# Перед коммитом: ключи в индексе (gitleaks, tools/secret_scan.py), затем проверки — те же,
# что в CI, из тестов только затронутые (check.sh --quick).
# Работает для любого агента и для человека; раскладывает tools/install_hooks.sh.
root="$(git rev-parse --show-toplevel)"
python3 "$root/tools/secret_scan.py" staged || exit 1
# тяжёлое — по одному на машине (tools/hook_lock.sh): иначе хуки worktree душат друг друга
sh "$root/tools/hook_lock.sh" sh "$root/tools/check.sh" --quick
